void setup() {
  Serial.begin(115200);
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDR)) {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;);
  }
  display.setRotation(0);
  display.clearDisplay();
  display.display();
}

void loop() {

  display.clearDisplay();
  display.drawBitmap(0, 0, smileyface, 128, 64, SSD1306_WHITE);
  display.display();

  delay(5000);

  display.clearDisplay();
  display.drawBitmap(0,0, sadface, 128, 64, SSD1306_WHITE);
  display.display();

  delay(5000);
}